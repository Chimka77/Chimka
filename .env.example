NODE_ENV=production
PORT=3000
# Public address of your site, no trailing slash
APP_URL=https://yourdomain.com
# Long random string: run  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=
# Where the database and generated videos are stored (use a persistent disk)
DATA_DIR=./data

# Email (Resend: https://resend.com). MAIL_FROM must be on a domain you verified there
RESEND_API_KEY=
MAIL_FROM=Views <no-reply@yourdomain.com>

# AI generation (Replicate: https://replicate.com). Models are "owner/name"
REPLICATE_API_TOKEN=
MODEL_VIDEO=
MODEL_3D=
# Safety valve for your wallet: max generations per day across ALL users
GLOBAL_DAILY_CAP=300

# Stripe card payments (use test keys first)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
