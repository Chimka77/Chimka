# ---- server ----
PORT=3000
DB_FILE=./buggyrush.db

# ---- TON ----
# Owner wallet receives the platform fee (batch-pay yourself from time to time)
OWNER_ADDRESS=UQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Treasury wallet: players deposit TO it, withdrawals are paid FROM it (v4R2, workchain 0)
TREASURY_ADDRESS=UQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 24 secret words of the treasury wallet. Keep this file OUT of git!
TREASURY_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24
# Free key raises toncenter rate limits: https://t.me/toncenter
TONCENTER_API_KEY=
TONCENTER_BASE=https://toncenter.com/api/v2

# ---- security ----
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
# The Host the wallet signs in ton-proof. MUST match where the API is reachable.
APP_DOMAIN=api.yourdomain.com
PLATFORM_FEE=0.10
MIN_TX_CENTS=100
MAX_WITHDRAW_CENTS=1000000

# ---- DANGER: local testing only. Lets anyone log in as any address without a signature ----
INSECURE_DEV_AUTH=0
