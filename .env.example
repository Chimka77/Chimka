# ---------- AI video ----------
# Get a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Any long random string. Make one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Video model in owner/name form. Check the model page for its price per video.
MODEL_VIDEO=minimax/video-01
# Optional cheaper model for the Free plan (leave empty to use MODEL_VIDEO)
MODEL_VIDEO_FREE=
# Text-to-3D model for paid plans. Check the model's API tab for its inputs.
MODEL_3D=
# Optional extra model inputs as JSON, for example {"aspect_ratio":"16:9"}
MODEL_VIDEO_INPUT={}
MODEL_3D_INPUT={}

# ---------- Stripe payments (use test keys first) ----------
# Dashboard > Developers > API keys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Dashboard > Developers > Webhooks (or the "stripe listen" command when testing locally)
STRIPE_WEBHOOK_SECRET=
# Dashboard > Product catalog: make two monthly prices, $10 and $50, and paste their price IDs
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
# The public address of your app, used when sending users back from the card portal
APP_URL=http://localhost:3000

# ---------- Server ----------
PORT=3000
NODE_ENV=development
